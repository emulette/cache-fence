{
  "name": "cache-fence",
  "version": "0.1.0",
  "description": "Generation-fenced Redis cache: atomically rejects stale writes that cross an invalidation",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "redis",
    "cache",
    "cache-invalidation",
    "fencing",
    "fencing-token",
    "race-condition",
    "stale-while-revalidate",
    "single-flight",
    "cas",
    "generation"
  ],
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "redis": ">=5.0.0 <7"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emulette/cache-fence.git"
  },
  "homepage": "https://github.com/emulette/cache-fence#readme",
  "bugs": {
    "url": "https://github.com/emulette/cache-fence/issues"
  },
  "devDependencies": {
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^26.2.0",
    "redis": "^6.2.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
